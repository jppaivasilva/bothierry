OPENAI_API_KEY=sua-chave-aqui
# opcional: modelo de imagem (padrao gpt-image-1.5)
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# opcional: pesquisa na web e leitura de links pelo agente (chave gratis em tavily.com)
# TAVILY_API_KEY=sua-chave
# opcional: placares de futebol (chave gratis em football-data.org)
# FOOTBALL_DATA_API_KEY=sua-chave
# opcional: teto mensal de gasto com IA em US$ (padrao 10; 0 desliga)
# AI_MONTHLY_BUDGET_USD=10
# experimental: liga o !statusgrupo (postar status de grupo; so root) e define quem e root
# GROUP_STATUS_ENABLED=1
# ROOT_NUMBERS=5511999999999
# opcional: cartoes que saem sozinhos tambem como status do grupo (precisa de GROUP_STATUS_ENABLED=1). Hoje: previsao
# GROUP_STATUS_AUTO=previsao
